msgstr "(!)特殊代码将自动合并到客户端的 .ovpn 配置文件中"

msgid "The operation failed. Check the server address and certificates."
msgstr "操作失败，请检查服务端地址和证书。"

msgid "Starting…"
msgstr "启动中…"

msgid "Status unavailable"
msgstr "未能读取状态"

msgid "Enable OpenVPN server"
msgstr "启用 OpenVPN 服务端"

msgid "Apply the public address and port before downloading the client profile."
msgstr "请先保存并应用公网地址和端口，再下载客户端配置。"

msgid "The OpenVPN server interface or firewall rule is missing."
msgstr "缺少 OpenVPN 服务端接口或防火墙规则。"

msgid "Enter one option per row, for example route 192.168.10.0 255.255.255.0 or dhcp-option DNS 192.168.10.1."
msgstr "每行填写一条推送配置。例如用 route 192.168.10.0 255.255.255.0 推送路由，用 dhcp-option DNS 192.168.10.1 推送 DNS。"

msgid "Enter a single unquoted OpenVPN push option."
msgstr "每行填写一条不带引号的 OpenVPN 推送配置。"

msgid "Edit client options"
msgstr "编辑客户端附加配置"

msgid "The client options changed. Reopen the editor to load the latest copy."
msgstr "客户端附加配置已被修改，请重新打开编辑器读取最新内容。"

msgid "Unable to save the client options."
msgstr "无法保存客户端附加配置。"

msgid "Replace the CA, server and client certificates? Connected clients will disconnect. Download and import a new .ovpn file on each client."
msgstr "确定重新生成 CA、服务端和客户端证书吗？已连接的客户端会断开。请为每个客户端重新下载并导入 .ovpn 文件。"

msgid "Certificates replaced. Download the new client profile."
msgstr "证书已更新，请下载新的客户端配置文件。"
