#!/bin/sh

if [ "$PKG_UPGRADE" != 1 ] && ! uci -q get luci.themes.Design >/dev/null; then
	uci set luci.themes.Design='/luci-static/design'
	# AIR6 registers Design as an alternative alongside the default Argon.
	if [ ! -d /www/luci-static/argon ]; then
		uci set luci.main.mediaurlbase='/luci-static/design'
	fi
	uci commit luci
fi
exit 0
